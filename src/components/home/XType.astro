---
import Cross from '../brand/Cross.astro';
import { getDict, type Locale } from '../../i18n';
interface Props { lang: Locale }
const t = getDict(Astro.props.lang).home.type;
const rep = (w: string) => Array.from({ length: 4 }, () => w);
---
<section class="xt surface-crimson" data-xtype aria-label={t.words.join(' · ')}>
  <svg class="xt__defs" width="0" height="0" aria-hidden="true" focusable="false">
    <filter id="hx-warp" x="-10%" y="-20%" width="120%" height="140%">
      <feTurbulence type="fractalNoise" baseFrequency="0.006 0.035" numOctaves="2" seed="7" result="n" data-xt-noise />
      <feDisplacementMap in="SourceGraphic" in2="n" scale="0" xChannelSelector="R" yChannelSelector="G" data-xt-warp />
    </filter>
  </svg>
  <p class="xt__eyebrow t-label wrap-full">{t.eyebrow}</p>
  <div class="xt__rows" aria-hidden="true" data-xt-rows>
    {t.words.map((w, i) => (
      <div class:list={['xt__row', `xt__row--${i}`]} data-xt-row={i % 2 ? 1 : -1}>
        {rep(w).map((x, j) => (
          <>
            <span class:list={['xt__word', { 'xt__word--outline': (i + j) % 2 === 1 }]}>{x}</span>
            <span class="xt__glyph"><Cross /></span>
          </>
        ))}
      </div>
    ))}
  </div>
  <div class="xt__center" aria-hidden="true" data-xt-cross><Cross /></div>
</section>
<style>
  .xt { position: relative; overflow: hidden; padding-block: clamp(80px, 12vw, 200px); isolation: isolate; }
  .xt__defs { position: absolute; }
  .xt__eyebrow { margin-bottom: clamp(32px, 5vw, 72px); color: var(--ice-90); }
  .xt__rows { display: flex; flex-direction: column; gap: .02em; filter: url(#hx-warp); font: 400 clamp(4rem, 15vw, 17rem)/.86 var(--font-display); letter-spacing: -0.05em; }
  .xt__row { display: flex; align-items: center; gap: .18em; white-space: nowrap; will-change: transform; width: max-content; }
  .xt__row--0 { transform: translateX(-12%); }
  .xt__row--1 { transform: translateX(-38%); }
  .xt__row--2 { transform: translateX(-20%); }
  .xt__word { color: var(--color-obsidian); }
  .xt__word--outline { color: transparent; -webkit-text-stroke: 1.5px var(--color-ice); }
  .xt__glyph { width: .62em; flex: none; color: var(--color-ice); display: inline-block; }
  .xt__center { position: absolute; z-index: 2; left: 50%; top: 50%; width: clamp(120px, 18vw, 280px); transform: translate(-50%, -50%); color: var(--color-ice); pointer-events: none; filter: drop-shadow(0 12px 40px rgb(var(--rgb-obsidian) / .45)); }
  @media (prefers-reduced-motion: reduce) { .xt__rows { filter: none; } }
</style>
