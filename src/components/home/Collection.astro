---
import Icon from '../ui/Icon.astro';
import { getDict, lp, type Locale } from '../../i18n';
import type { Catalog, Product } from '../../lib/types';
import { imageForColor } from '../../lib/catalog';
interface Props { lang: Locale; catalog: Catalog }
const { lang, catalog } = Astro.props;
const d = getDict(lang);
const t = d.home.collection;
const by = (h: string) => catalog.products.find((p) => p.handle === h) ?? null;
const colorAt = (p: Product | null, i: number) => p?.options.find((o) => o.key === 'color')?.values[i] ?? p?.options.find((o) => o.key === 'color')?.values[0] ?? null;
const pick = (h: string, ci: number, view: 'front' | 'back' = 'front') => {
  const p = by(h) ?? catalog.products[ci % catalog.products.length];
  return p ? { p, img: imageForColor(p, colorAt(p, ci), view), color: colorAt(p, ci) } : null;
};
const tiles = [
  { cls: 'a', surf: 'plinth', ...pick('hoodie-001', 0) },
  { cls: 'b', surf: 'surface-crimson', ...pick('zip-hoodie-001', 0) },
  { cls: 'c', surf: 'plinth--dark', ...pick('baggy-pant-001', 1) },
  { cls: 'd', surf: 'plinth', ...pick('crewneck-001', 1, 'back') },
  { cls: 'e', surf: 'surface-crimson', ...pick('beanie-001', 0) },
].filter((x) => x.p && x.img);
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="coll section" data-collection>
  <div class="coll__head wrap-full">
    <p class="t-label t-muted" data-reveal="fade">{t.eyebrow}</p>
    <h2 class="t-section" data-split>{t.title}</h2>
    <p class="t-body coll__body" data-reveal="fade" style="--d:.15s">{t.body}</p>
    <a class="btn btn--ghost coll__cta" href={lp(lang, '/collections/drop-01')} data-reveal="fade" style="--d:.25s">{t.cta} <Icon name="arrow-right" class="btn__arrow" /></a>
  </div>
  <div class="coll__grid wrap-full">
    {tiles.map((tile, i) => (
      <a class:list={['coll__tile', `coll__tile--${tile.cls}`]} href={lp(lang, `/products/${tile.p!.handle}`) + (tile.color ? `?color=${encodeURIComponent(tile.color)}` : '')} data-cursor="view" data-liquid>
        <span class:list={['coll__media', tile.surf]} data-reveal="mask" style={`--d:${(i % 3) * 0.12}s`}>
          <img src={tile.img!.src} srcset={tile.img!.srcset} sizes="(min-width: 750px) 45vw, 90vw" width={tile.img!.width} height={tile.img!.height} alt={tile.img!.alt} loading="lazy" decoding="async" data-parallax={tile.cls === 'a' ? '-8' : tile.cls === 'c' ? '10' : '6'} />
        </span>
        <span class="coll__cap"><span class="t-label t-muted">{pad(i + 1)}</span><span>{tile.p!.title}</span><span class="t-label t-muted coll__color">{tile.color}</span></span>
      </a>
    ))}
  </div>
</section>
<style>
  .coll__head { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--space-6) var(--space-5); margin-bottom: clamp(48px, 7vw, 120px); align-items: end; }
  .coll__head > .t-label { grid-column: 1 / -1; }
  .coll__head h2 { grid-column: 1 / 8; }
  .coll__body { grid-column: 8 / 12; }
  .coll__cta { grid-column: 8 / 12; justify-self: start; }
  .coll__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: clamp(16px, 2vw, 32px); align-items: start; }
  .coll__tile { display: flex; flex-direction: column; gap: var(--space-3); }
  .coll__media { position: relative; display: block; overflow: hidden; aspect-ratio: 4 / 5; }
  .coll__media img { position: absolute; inset: -6% 0; width: 100%; height: 112%; object-fit: contain; transition: transform 1.4s var(--ease-standard); }
  .coll__tile:hover .coll__media img { transform: scale(1.04); }
  .coll__cap { display: flex; gap: var(--space-4); align-items: baseline; font-size: var(--fs-small); }
  .coll__color { margin-left: auto; }
  .coll__tile--a { grid-column: 1 / 7; grid-row: 1 / 3; }
  .coll__tile--b { grid-column: 8 / 12; grid-row: 1; }
  .coll__tile--c { grid-column: 7 / 13; grid-row: 2; margin-top: clamp(24px, 4vw, 64px); }
  .coll__tile--c .coll__media { aspect-ratio: 16 / 11; }
  .coll__tile--d { grid-column: 2 / 6; grid-row: 3; margin-top: clamp(32px, 6vw, 96px); }
  .coll__tile--e { grid-column: 8 / 11; grid-row: 3; margin-top: clamp(96px, 14vw, 220px); }
  .coll__tile--e .coll__media { aspect-ratio: 1; }
  @media (max-width: 749px) {
    .coll__head { grid-template-columns: 1fr; }
    .coll__head > * { grid-column: 1 / -1 !important; }
    .coll__grid { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .coll__tile--a { grid-column: 1 / -1; grid-row: auto; }
    .coll__tile--b { grid-column: 1 / 5; grid-row: auto; }
    .coll__tile--c { grid-column: 2 / -1; grid-row: auto; margin-top: 0; }
    .coll__tile--d { grid-column: 1 / 4; grid-row: auto; margin-top: 0; }
    .coll__tile--e { grid-column: 4 / -1; grid-row: auto; margin-top: 48px; }
  }
</style>
