---
import Icon from './Icon.astro';
import { getDict, lp, type Locale } from '../../i18n';
interface Props { lang: Locale; id?: string; tone?: 'ice' | 'obsidian' }
const { lang, id = 'nl', tone = 'ice' } = Astro.props;
const t = getDict(lang).newsletter;
const [before, after] = t.consent.split('{privacy}');
---
<form class:list={['nlf', `nlf--${tone}`]} data-newsletter novalidate>
  <div class="nlf__row">
    <label class="sr-only" for={`${id}-email`}>{t.label}</label>
    <input class="input nlf__input" id={`${id}-email`} name="email" type="email" inputmode="email" autocomplete="email" required placeholder={t.placeholder} aria-describedby={`${id}-msg`} />
    <button class="btn btn--lg nlf__btn" type="submit">{t.submit} <Icon name="arrow-right" class="btn__arrow" /></button>
  </div>
  <label class="check">
    <input type="checkbox" name="consent" required />
    <span>{before}<a class="link-u link-u--on" href="/legal/privacidad" hreflang="es-ES">{t.privacy}</a>{after}</span>
  </label>
  <p class="nlf__msg t-small" id={`${id}-msg`} role="status" aria-live="polite" data-form-msg></p>
</form>
<style>
  .nlf { display: grid; gap: var(--space-4); max-width: 640px; }
  .nlf__row { display: flex; gap: var(--space-2); }
  .nlf__input { flex: 1; min-height: 56px; }
  .nlf--ice .nlf__input { background: var(--obsidian-08); border-color: var(--obsidian-40); }
  .nlf--ice .nlf__btn { --btn-bg: var(--color-obsidian); --btn-fg: var(--color-ice); }
  .nlf__msg:empty { display: none; }
  .nlf__msg { border-left: 2px solid var(--color-crimson); padding-left: var(--space-3); }
  @media (max-width: 599px) { .nlf__row { flex-direction: column; } }
</style>
