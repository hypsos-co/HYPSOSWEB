# ─────────────────────────────────────────────────────────────
# HYPSOS — environment variables
# Copy to `.env` and fill in. Never commit real values.
# ─────────────────────────────────────────────────────────────

# Public canonical URL (sitemap, canonical, Open Graph)
SITE_URL=https://hypsos.co

# Shopify Storefront API (headless). The Storefront *public* access token is designed
# to be used in the browser (read catalog + manage carts). NEVER put an Admin API token here.
PUBLIC_SHOPIFY_STORE_DOMAIN=            # e.g. hypsos.myshopify.com
PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=
PUBLIC_SHOPIFY_API_VERSION=2026-07

# Optional — form endpoints (POST, JSON). Without them, forms fall back to opening
# an email to the contact address (no data is stored by this site).
PUBLIC_NEWSLETTER_ENDPOINT=
PUBLIC_CONTACT_ENDPOINT=

# Optional — campaign media (absolute or /public paths). Empty = editorial fallback.
PUBLIC_CAMPAIGN_HERO_IMAGE=
PUBLIC_CAMPAIGN_FILM_SRC=
PUBLIC_CAMPAIGN_FILM_POSTER=

# Optional — analytics (only loaded after explicit consent in the cookie manager)
PUBLIC_ANALYTICS_SRC=
